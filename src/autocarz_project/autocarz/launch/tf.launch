    <!-- <node pkg="tf" type="static_transform_publisher" name="tf_livox" args="0.93 0.04 0.68 0 0 0 1 base_link livox 100" /> -->

    <node pkg="autocarz" type="car_viusal" name="car_viusal_in">
        <param name="in_or_out" value="in" type="str"/>

    </node>

    <node pkg="autocarz" type="car_viusal" name="car_viusal_out"  output="screen" >
        <param name="in_or_out" value="out" type="str"/>

    </node>

    <node pkg="autocarz" type="path_pub.py" name="path_pub"  output="screen" >
    </node>

</launch>